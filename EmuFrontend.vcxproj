<?xml version="1.0" encoding="utf-8"?>
<!--
  EmuFrontend.vcxproj
  Visual Studio 2022 project for the emulator frontend.

  Directory layout expected:
    emufrontend\
      main.cpp
      config.cpp / config.h
      launcher.cpp / launcher.h
      stb_image.h              < from https://github.com/nothings/stb
      imgui\                   < Dear ImGui source drop
        imgui.h / imgui.cpp
        imgui_draw.cpp
        imgui_tables.cpp
        imgui_widgets.cpp
        imgui_impl_sdl2.h / imgui_impl_sdl2.cpp
        imgui_impl_sdlrenderer2.h / imgui_impl_sdlrenderer2.cpp
      SDL2\                    < SDL2 development libraries
        include\
        lib\x64\
          SDL2.lib
          SDL2main.lib
          SDL2.dll

  After building, copy SDL2.dll next to the .exe.
-->
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
