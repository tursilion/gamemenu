      <AdditionalIncludeDirectories>
      </AdditionalIncludeDirectories>
      <PreprocessorDefinitions>
        _CRT_SECURE_NO_WARNINGS;
        %(PreprocessorDefinitions)
      </PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(ProjectDir)SDL2\lib\x32</AdditionalLibraryDirectories>
      <AdditionalDependencies>SDL2.lib;SDL2main.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- SDL2main requires the WinMain entry point, which SDL2 redirects
           to main(int, char**). SubSystem must be Windows to avoid a
           console window appearing behind the fullscreen UI. -->
      <SubSystem>Windows</SubSystem>
    </Link>
  </ItemDefinitionGroup>
  <!-- Debug-specific -->
